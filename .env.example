# --- Required infrastructure ---
DATABASE_URL=postgresql://user:pass@host:5432/nomad
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INTERNAL_AGENT_SECRET=change-me-to-a-long-random-string

# --- Tool API keys ---
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
TAVILY_API_KEY=your-tavily-api-key

# --- Place imagery (hero + per-city + trending photos, self-hosted) ---
# Optional: Pexels long-tail stock-photo search for places without a usable
# Wikipedia page. Empty -> Wikipedia-only resolution. Get a key (free) at
# https://www.pexels.com/api/
PEXELS_API_KEY=
# Public Supabase Storage bucket the agent uploads resolved photos into.
# Defaults to "place-images" — only set this to override the bucket name.
SUPABASE_IMAGE_BUCKET=place-images

# --- Per-role LLM provider/model selection ---
# Research agents: swap to cerebras (1M TPD free) or google to avoid Groq 100k TPD cap
LLM_YOUTUBE_PROVIDER=groq
LLM_YOUTUBE_MODEL=qwen/qwen3.8-27b
LLM_YOUTUBE_LONGFORM_PROVIDER=groq
LLM_YOUTUBE_LONGFORM_MODEL=qwen/qwen3.8-27b
LLM_REDDIT_PROVIDER=groq
LLM_REDDIT_MODEL=qwen/qwen3.8-27b
LLM_GOOGLE_PROVIDER=groq
LLM_GOOGLE_MODEL=qwen/qwen3.8-27b
# Synthesizer: Cerebras gpt-oss-120b (structured itinerary JSON) with Groq
# openai/gpt-oss-120b fallback. Smaller Cerebras calls use qwen-3.8-27b.
LLM_SYNTH_PROVIDER=cerebras
LLM_SYNTH_MODEL=gpt-oss-120b
LLM_SYNTH_FALLBACK_PROVIDER=groq
LLM_SYNTH_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_GEO_PLANNER_PROVIDER=cerebras
LLM_GEO_PLANNER_MODEL=qwen-3.8-27b
LLM_TRENDING_PROVIDER=cerebras
LLM_TRENDING_MODEL=qwen-3.8-27b

# Cerebras public IDs (this account): gpt-oss-120b, qwen-3.8-27b, gemma-4-31b
# Groq IDs on this account: qwen/qwen3.8-27b, openai/gpt-oss-120b
# llama-3.3-70b-versatile is no longer returned by Groq for this key.

# --- Provider API keys (set only the ones you use) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=

# --- Optional observability ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=

# ---- redis cache ----
REDIS_URL=

